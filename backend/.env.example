DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/campaign_assistant

CORS_ORIGINS=http://localhost:5173

# Google Ads (real API). Credentials live in backend/google-ads.yaml.
# This is the customer account campaigns are published into (digits only, no dashes).
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Set to true to skip real API calls and use the offline mock (see docs/MOCK_MODE.md).
GOOGLE_ADS_USE_MOCK=false
